{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "interface-cli",
  "root": "apps/interface-cli",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/interface-cli",
        "format": [
          "cjs"
        ],
        "bundle": true,
        "main": "apps/interface-cli/src/main.ts",
        "tsConfig": "apps/interface-cli/tsconfig.app.json",
        "assets": [],
        "generatePackageJson": false,
        "esbuildOptions": {
          "entryNames": "[name]",
          "sourcemap": false,
          "banner": {
            "js": "#!/usr/bin/env node"
          },
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "continuous": true,
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "interface-cli:build",
        "runBuildTargetDependencies": true
      },
      "configurations": {
        "development": {
          "buildTarget": "interface-cli:build:development"
        },
        "production": {
          "buildTarget": "interface-cli:build:production"
        }
      }
    }
  }
}
